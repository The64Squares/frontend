# ==============================================================================
# THE64SQUARES Frontend Environment Variables (Vercel / Local)
# ==============================================================================

# Backend API Base URL
# - In local development: Leave blank to use "proxy" in package.json (http://localhost:5000)
# - In Vercel Production: Set to your deployed backend URL (e.g. https://your-backend.onrender.com or https://api.the64squares.com)
REACT_APP_BACKEND_URL=

# Optional: Stripe Public Key for client-side checkout
REACT_APP_STRIPE_API_KEY=pk_test_sample
